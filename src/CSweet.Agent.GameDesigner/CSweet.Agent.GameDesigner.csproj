<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>3.1.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSweet.Agent.SDK.VideoGame.Contracts" Version="1.3.0" />
    <PackageReference Include="CSweet.Agent.SDK" Version="5.26.0" Condition="'$(UseLocalCSweetAgentSdk)' != 'true'" />
    <ProjectReference Include="$(CSweetAgentSdkRepositoryRoot)\src\CSweet.Agent.SDK\CSweet.Agent.SDK.csproj" Condition="'$(UseLocalCSweetAgentSdk)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <Content Include="..\..\csweet-plugin.json" Link="csweet-plugin.json" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="content\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../extensions/video-game/*.cs" Link="Extension/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
