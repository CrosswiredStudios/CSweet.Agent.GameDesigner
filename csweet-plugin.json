{
  "$schema": "https://raw.githubusercontent.com/CrosswiredStudios/CSweetAgentSdk/main/schemas/csweet-plugin.v2.schema.json",
  "manifestVersion": "2.0",
  "kind": "agent",
  "rolePolicy": {
    "profile": "individual-contributor.v1",
    "declaredRoleKeys": ["game-designer"],
    "specializationKeys": ["video-game-development", "game-design", "gameplay-systems", "progression-balance", "game-content", "prototype-design"]
  },
  "id": "com.csweet.video-game-designer",
  "name": "C-Sweet Video Game Designer",
  "version": "2.1.1",
  "publisher": { "id": "com.csweet", "name": "C-Sweet" },
  "runtime": {
    "type": "dotnet-project",
    "projectPath": "src/CSweet.Agent.GameDesigner/CSweet.Agent.GameDesigner.csproj",
    "targetFramework": "net10.0",
    "defaultActivationMode": "OnDemand",
    "defaultTickFrequencySeconds": 300,
    "supportsMultipleInstallations": true,
    "maximumConcurrentJobs": 1
  },
  "protocol": { "minimumVersion": "2.0", "maximumVersion": "2.x" },
  "provides": [
    {
      "name": "work.execution.run.v1",
      "description": "Author an exact, evidence-grounded gameplay systems design for one assigned board item.",
      "inputSchema": { "type": "object", "additionalProperties": true, "required": ["sprintExecutionId", "itemExecutionId", "stageExecutionId", "attemptId", "organizationId", "boardId", "sprintId", "itemId", "assignmentRevision", "boardKey", "itemIdentifier", "policyRevisionId", "stageKey", "traversal", "attempt", "deadline", "instructions", "item", "input", "priorOutcomes", "evidence"], "properties": { "context": { "type": "object" }, "assignmentRevision": { "type": "integer", "minimum": 1 }, "roleKey": { "const": "game-designer" }, "taskTypeKey": { "type": "string", "minLength": 1 }, "instructions": { "type": "string", "minLength": 1 }, "documents": { "type": "array", "items": { "type": "object" } }, "evidence": { "type": "array", "items": { "type": "object" } }, "producerOrganizationUserId": { "type": "string", "format": "uuid" }, "creativeDirectorOrganizationUserId": { "type": "string", "format": "uuid" } } },
      "outputSchema": { "type": "object", "additionalProperties": true },
      "executionTimeoutSeconds": 900,
      "idempotency": "work-item",
      "riskClass": "standard"
    },
    {
      "name": "agent.configuration.describe.v1",
      "description": "Describe Game Designer configuration.",
      "inputSchema": { "type": "object", "additionalProperties": true },
      "outputSchema": { "type": "object", "additionalProperties": true },
      "executionTimeoutSeconds": 30,
      "idempotency": "none",
      "riskClass": "standard"
    },
    {
      "name": "agent.configuration.update.v1",
      "description": "Update Game Designer configuration.",
      "inputSchema": { "type": "object", "additionalProperties": true },
      "outputSchema": { "type": "object", "additionalProperties": true },
      "executionTimeoutSeconds": 30,
      "idempotency": "work-item",
      "riskClass": "standard"
    }
  ],
  "requires": [
    { "name": "platform.llm.chat-stream.v1", "scope": "organization", "purpose": "Produce vision-grounded, substantive gameplay-system decisions." },
    { "name": "work.item.read", "scope": "organization", "purpose": "Read only the authoritative assigned board item." },
    { "name": "work.item.comment", "scope": "organization", "purpose": "Record progress, blockers, findings, and evidence on the work item." },
    { "name": "platform.artifact.read.v1", "scope": "organization", "purpose": "Read authorized exact accepted document revisions and hashes." },
    { "name": "platform.artifact.create.v1", "scope": "organization", "purpose": "Create the Game Designer-owned durable design." },
    { "name": "platform.artifact.submit.v1", "scope": "organization", "purpose": "Submit the exact deliverable revision for accountable review." },
    { "name": "communication.coordination.read.v1", "scope": "team", "purpose": "Read planning and estimation coordination." },
    { "name": "communication.coordination.respond.v1", "scope": "team", "purpose": "Respond with role-owned planning, estimation, or review evidence." },
    { "name": "platform.agent-operating-state.read.v1", "scope": "organization", "purpose": "Recover project/work-item state and duplicate-delivery outcomes after restart." },
    { "name": "platform.agent-operating-state.write.v1", "scope": "organization", "purpose": "Persist revision-safe state isolated by Workstream and authoritative work item." }
  ],
  "events": { "subscribes": ["com.csweet.agent.coordination.turn-requested.v1"] },
  "configuration": [
    { "key": "llmProviderId", "type": "provider", "label": "LLM provider", "required": true, "secret": false },
    { "key": "llmModel", "type": "model", "label": "Model", "required": true, "secret": false, "dependsOnFieldKey": "llmProviderId" }
  ],
  "credentials": [],
  "webAccess": { "mode": "None", "rules": [] },
  "ui": [],
  "catalog": {
    "summary": "Accountable game designer for mechanics, gameplay systems, progression, balance, prototype hypotheses, and content rules.",
    "category": "Creative",
    "role": { "key": "game-designer", "name": "Video Game Designer" },
    "license": { "spdxId": "MIT" },
    "iconUrls": [],
    "roleAliases": ["Game Designer", "Systems Designer"],
    "keywords": ["game design", "gameplay systems", "progression", "balance"],
    "documentationUrl": "README.md"
  }
}
