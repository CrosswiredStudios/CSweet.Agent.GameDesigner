{
  "$schema": "https://raw.githubusercontent.com/CrosswiredStudios/CSweetAgentSdk/main/schemas/csweet-plugin.v2.schema.json",
  "manifestVersion": "2.0",
  "kind": "agent",
  "rolePolicy": {
    "profile": "individual-contributor.v1",
    "declaredRoleKeys": [
      "game-designer"
    ],
    "specializationKeys": [
      "video-game-development",
      "game-design",
      "gameplay-systems",
      "progression-balance",
      "game-content",
      "prototype-design"
    ]
  },
  "id": "com.csweet.video-game-designer",
  "name": "Hana Mori",
  "version": "2.4.1",
  "publisher": {
    "id": "com.csweet",
    "name": "C-Sweet"
  },
  "runtime": {
    "type": "dotnet-project",
    "projectPath": "src/CSweet.Agent.GameDesigner/CSweet.Agent.GameDesigner.csproj",
    "targetFramework": "net10.0",
    "defaultActivationMode": "OnDemand",
    "defaultTickFrequencySeconds": 300,
    "supportsMultipleInstallations": true,
    "maximumConcurrentJobs": 1
  },
  "protocol": {
    "minimumVersion": "2.0",
    "maximumVersion": "2.x"
  },
  "provides": [
    {
      "name": "work.execution.run.v2",
      "description": "Execute the authoritative task or delivery-plan scope with exact revision evidence and independent QA.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "format": "uuid"
          },
          "stageExecutionId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "workstreamId": {
            "type": "string",
            "format": "uuid"
          },
          "boardId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationUserId": {
            "type": "string",
            "format": "uuid"
          },
          "itemId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "deliveryPlanId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "sprintId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "sprintExecutionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "agentInstallationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "policyRevisionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "scopeRevision": {
            "type": "integer",
            "minimum": 0
          },
          "assignmentRevision": {
            "type": "integer",
            "minimum": 0
          },
          "planningRevision": {
            "type": "integer",
            "minimum": 0
          },
          "traversal": {
            "type": "integer",
            "minimum": 0
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "identifier": {
            "type": "string"
          },
          "stageKey": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "enum": [
              "Task",
              "Story",
              "Epic",
              "Release"
            ]
          },
          "item": {
            "type": "object"
          },
          "input": {
            "type": "object"
          },
          "priorOutcomes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "permittedOutcomes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "executionId",
          "stageExecutionId",
          "attemptId",
          "organizationId",
          "workstreamId",
          "boardId",
          "scope",
          "scopeRevision",
          "organizationUserId",
          "assignmentRevision",
          "planningRevision",
          "stageKey",
          "attempt",
          "deadline",
          "instructions",
          "item",
          "input",
          "priorOutcomes",
          "evidence",
          "permittedOutcomes"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "stageExecutionId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "disposition": {
            "enum": [
              "Completed",
              "Blocked",
              "Failed"
            ]
          },
          "outcomeCode": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "output": {},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "stageExecutionId",
          "attemptId",
          "disposition",
          "outcomeCode",
          "summary",
          "output",
          "evidence",
          "diagnostics"
        ],
        "additionalProperties": false
      },
      "executionTimeoutSeconds": 3600,
      "idempotency": "work-item",
      "riskClass": "standard"
    },
    {
      "name": "work.execution.run.v1",
      "description": "Author an exact, evidence-grounded gameplay systems design for one assigned board item.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "sprintExecutionId",
          "itemExecutionId",
          "stageExecutionId",
          "attemptId",
          "organizationId",
          "boardId",
          "sprintId",
          "itemId",
          "assignmentRevision",
          "boardKey",
          "itemIdentifier",
          "policyRevisionId",
          "stageKey",
          "traversal",
          "attempt",
          "deadline",
          "instructions",
          "item",
          "input",
          "priorOutcomes",
          "evidence"
        ],
        "properties": {
          "context": {
            "type": "object"
          },
          "assignmentRevision": {
            "type": "integer",
            "minimum": 1
          },
          "roleKey": {
            "const": "game-designer"
          },
          "taskTypeKey": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "producerOrganizationUserId": {
            "type": "string",
            "format": "uuid"
          },
          "creativeDirectorOrganizationUserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "executionTimeoutSeconds": 900,
      "idempotency": "work-item",
      "riskClass": "standard"
    },
    {
      "name": "agent.configuration.describe.v1",
      "description": "Describe Game Designer configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "none",
      "riskClass": "standard"
    },
    {
      "name": "agent.configuration.update.v1",
      "description": "Update Game Designer configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "work-item",
      "riskClass": "standard"
    }
  ],
  "requires": [
    {
      "name": "work.personal-todo.claim.v1",
      "scope": "organization",
      "purpose": "SDK lifecycle for calendar-triggered personal assignments; existing execution restrictions remain."
    },
    {
      "name": "work.personal-todo.complete.v1",
      "scope": "organization",
      "purpose": "SDK lifecycle for calendar-triggered personal assignments; existing execution restrictions remain."
    },
    {
      "name": "work.personal-todo.block.v1",
      "scope": "organization",
      "purpose": "SDK lifecycle for calendar-triggered personal assignments; existing execution restrictions remain."
    },
    {
      "name": "work.personal-todo.release.v1",
      "scope": "organization",
      "purpose": "SDK lifecycle for calendar-triggered personal assignments; existing execution restrictions remain."
    },
    {
      "name": "work.calendar.read.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.create.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.update.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.cancel.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.schedule.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "platform.llm.chat-stream.v1",
      "scope": "organization",
      "purpose": "Produce vision-grounded, substantive gameplay-system decisions."
    },
    {
      "name": "work.item.read",
      "scope": "organization",
      "purpose": "Read only the authoritative assigned board item."
    },
    {
      "name": "work.item.comment",
      "scope": "organization",
      "purpose": "Record progress, blockers, findings, and evidence on the work item."
    },
    {
      "name": "work.item.comment.update.v1",
      "scope": "organization",
      "purpose": "Correct this agent's own comment on the work item."
    },
    {
      "name": "work.item.comment.delete.v1",
      "scope": "organization",
      "purpose": "Retract this agent's own comment while its activity history is retained."
    },
    {
      "name": "platform.artifact.read.v1",
      "scope": "organization",
      "purpose": "Read authorized exact accepted document revisions and hashes."
    },
    {
      "name": "platform.artifact.create.v1",
      "scope": "organization",
      "purpose": "Create the Game Designer-owned durable design."
    },
    {
      "name": "platform.artifact.submit.v1",
      "scope": "organization",
      "purpose": "Submit the exact deliverable revision for accountable review."
    },
    {
      "name": "communication.coordination.read.v1",
      "scope": "team",
      "purpose": "Read planning and estimation coordination."
    },
    {
      "name": "communication.coordination.respond.v1",
      "scope": "team",
      "purpose": "Respond with role-owned planning, estimation, or review evidence."
    },
    {
      "name": "platform.agent-operating-state.read.v1",
      "scope": "organization",
      "purpose": "Recover project/work-item state and duplicate-delivery outcomes after restart."
    },
    {
      "name": "platform.agent-operating-state.write.v1",
      "scope": "organization",
      "purpose": "Persist revision-safe state isolated by Workstream and authoritative work item."
    }
  ],
  "events": {
    "subscribes": [
      "com.csweet.calendar.reminder-due.v1",
      "com.csweet.work.personal-todo.available.v1",
      "com.csweet.agent.coordination.turn-requested.v1"
    ]
  },
  "configuration": [
    {
      "key": "llmProviderId",
      "type": "provider",
      "label": "LLM provider",
      "required": true,
      "secret": false
    },
    {
      "key": "llmModel",
      "type": "model",
      "label": "Model",
      "required": true,
      "secret": false,
      "dependsOnFieldKey": "llmProviderId"
    },
    {
      "key": "maxContextWindowTokens",
      "type": "number",
      "label": "Maximum context-window tokens",
      "required": true,
      "secret": false,
      "description": "Planning ceiling for Game Designer model requests; set this no higher than the selected model's real context window.",
      "minimum": 16000,
      "step": 1000,
      "defaultValue": 256000
    },
    {
      "key": "maxOutputTokens",
      "type": "number",
      "label": "Maximum output tokens",
      "required": true,
      "secret": false,
      "description": "Budget for each Game Designer model response, including reasoning. Set this within the selected model and provider's supported limits.",
      "minimum": 1000,
      "step": 1000,
      "defaultValue": 128000,
      "lessThanFieldKey": "maxContextWindowTokens"
    }
  ],
  "credentials": [],
  "webAccess": {
    "mode": "None",
    "rules": []
  },
  "ui": [],
  "catalog": {
    "imageUrl": "https://raw.githubusercontent.com/CrosswiredStudios/CSweet.Agent.GameDesigner/main/assets/branding/portrait-v1.jpg",
    "companyLogoUrl": "https://raw.githubusercontent.com/CrosswiredStudios/CSweet.Agent.GameDesigner/main/assets/branding/csweet-icon.svg",
    "accentColor": "#AA6040",
    "summary": "Accountable game designer for mechanics, gameplay systems, progression, balance, prototype hypotheses, and content rules.",
    "category": "Creative",
    "role": {
      "key": "game-designer",
      "name": "Video Game Designer"
    },
    "license": {
      "spdxId": "MIT"
    },
    "iconUrls": [],
    "roleAliases": [
      "Game Designer",
      "Systems Designer"
    ],
    "keywords": [
      "game design",
      "gameplay systems",
      "progression",
      "balance"
    ],
    "documentationUrl": "README.md"
  }
}
